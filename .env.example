APP_ENV=development
APP_PORT=8080

POSTGRES_PASSWORD=change_me_in_production

# Local development (without Docker):
DATABASE_URL=postgresql://postgres:change_me_in_production@localhost:5432/chatdb?sslmode=disable

# Docker Compose overrides DATABASE_URL to use service name "postgres":
# DATABASE_URL=postgresql://postgres:change_me_in_production@postgres:5432/chatdb?sslmode=disable

JWT_SECRET=change_me_to_a_very_long_random_string_at_least_32_bytes

# Optional: comma-separated list of allowed WebSocket origins.
# Leave empty to reject all cross-origin WebSocket connections.
# WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
